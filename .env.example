APP_NAME=JARVIS
APP_ENV=development

# Existing integrations: keep their API contracts and ports.
EMAIL_MANAGER_BASE_URL=http://127.0.0.1:8001
FITNESS_MANAGER_BASE_URL=http://127.0.0.1:8002
EMAIL_MANAGER_API_KEY=

# Use Gemini (cloud) or Ollama (local by default).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
AI_TIMEOUT_SECONDS=30

# Phase 2 local memory security. Generate a strong random value and keep it private.
# Required to use /memory endpoints; send it as X-JARVIS-API-Key.
JARVIS_API_KEY=replace-with-a-long-random-secret
JARVIS_DATA_DIR=~/.jarvis
# Conversation history is opt-in and disabled by default.
MEMORY_STORE_CONVERSATIONS=false

# Phase 3: allow only these registered read-only tools.
JARVIS_ENABLED_TOOLS=email.high_priority.read,fitness.workouts.read
# Optional bearer token if Fitness Manager /workouts expects this auth contract.
FITNESS_MANAGER_API_TOKEN=
FITNESS_MANAGER_EMAIL=
FITNESS_MANAGER_PASSWORD=
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_ALLOW_WRITES=false
# Saved memory is withheld from Gemini unless you explicitly opt in.
MEMORY_CONTEXT_TO_CLOUD=false

# Phase 4: local reminders and browser voice console.
# Reminders are stored locally in ~/.jarvis/reminders.db by default.
# The voice console never saves the API key in browser localStorage.

# Phase 5: background health monitoring interval (seconds; effective range 15–3600).
MONITOR_INTERVAL_SECONDS=60

# Phase 6: optional desktop shell overrides (default localhost:8000).
# These are read from the desktop launch process environment.
JARVIS_DESKTOP_HOST=127.0.0.1
JARVIS_DESKTOP_PORT=8000

# Phase 7: optional offline wake listening (desktop app only; opt-in at runtime).
# Download and extract a Vosk model locally, then set this path; or select it in the app.
JARVIS_VOSK_MODEL_PATH=
JARVIS_WAKE_PHRASE=jarvis

# Phase 8: tasks are stored locally in ~/.jarvis/tasks.db (under JARVIS_DATA_DIR).
# Task endpoints require X-JARVIS-API-Key. Due dates must include a timezone.

# Phase 10: optional Google Calendar OAuth integration.
# Enable Google Calendar API and create an OAuth Desktop app client in Google Cloud Console.
GOOGLE_CALENDAR_CREDENTIALS=~/.jarvis/google-calendar-credentials.json
GOOGLE_CALENDAR_TOKEN=~/.jarvis/google-calendar-token.json
GOOGLE_CALENDAR_ID=primary

# Phase 12: proactively notify once when a pending task is due within this many minutes.
NOTIFY_TASK_DUE_SOON_MINUTES=30

# Phase 14: computer control is API-key protected and requires explicit per-action confirmation.
# Supported actions are restricted to HTTP(S) URLs and allow-listed apps (notepad, calculator, files).
# No arbitrary shell commands or unattended computer actions are supported.

# Phase 16: audit records and backups stay in JARVIS_DATA_DIR.
# Audit entries store route/method/status/duration/request ID only, not bodies or secrets.

# Phase 17: use /mobile on a trusted network. Do not port-forward JARVIS directly to the internet.
# For remote access, use a private VPN (e.g. WireGuard/Tailscale) or an HTTPS reverse proxy.

# Phase 18: optional Home Assistant smart-home integration.
# Create a long-lived access token in your Home Assistant profile and keep it private.
# Keep the URL on a trusted network/VPN; do not expose Home Assistant or JARVIS directly.
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=
# Exact entity IDs only; JARVIS can read/control only these listed light/switch/fan entities.
# Example: light.desk_lamp,switch.office_plug
HOME_ASSISTANT_ALLOWED_ENTITIES=

# Phase 19: recurring routines use the JARVIS server's local timezone.
# Manage routines through authenticated /routines endpoints; they create in-app notifications only.

# Phase 21: local bounded conversation context for follow-up commands.
# JARVIS stores recent command text and short summaries, not tool result payloads.
CONVERSATION_CONTEXT_ENABLED=true
CONVERSATION_CONTEXT_TURNS=8
